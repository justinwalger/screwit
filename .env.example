# Copy this file to .env and fill in real values. .env is gitignored.

# --- API (src.shared.config.Settings) ---
# Required. Hugging Face access token used to download the model at startup.
HF_API_KEY=
# Required. HF Hub repo id the model gets downloaded from, e.g. your-username/your-model-repo.
HF_MODEL_REPO_ID=

# Optional, defaults shown.
HF_URL=https://huggingface.co
# Uploaded/downloaded filename is derived as {MODEL_NAME}_onnx - keep this in
# sync with whatever model class the training notebook actually uploads.
MODEL_NAME=patchcore
# Minimum pred_score to classify as a defect - overrides the model's own pred_label.
DETECTION_THRESHOLD=0.6

# --- UI (src.shared.config.UISettings) ---
# BACKEND_API_URL optional, default shown.
BACKEND_API_URL=http://127.0.0.1:8000
APP_PASSWORD=

# --- Training (src.shared.config.TrainingSettings) ---
# Optional, defaults shown. Uses HF_API_KEY/HF_MODEL_REPO_ID/MODEL_NAME above
# to upload the trained model - no separate credentials needed.
# Model hyperparameters (batch sizes, epochs, ...) aren't set here - they live
# in configs/<model_name>.yaml, e.g. configs/patchcore.yaml when MODEL_NAME=patchcore.
DATA_ROOT=../data
CATEGORY=screw
WANDB_PROJECT=screwit
# W&B run name isn't set separately - it's built from CATEGORY-MODEL_NAME
# (see notebooks/train.ipynb) so it can't drift out of sync with either.
# Only needed if you don't already have `wandb login` set up locally.
WANDB_API_KEY=
